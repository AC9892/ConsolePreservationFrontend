{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pseudo Game Mounter",
  "version": "0.1.0",
  "identifier": "org.consolepreservation.pseudogamemounter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Pseudo Game Mounter",
      "width": 410,
      "height": 850,
      "minWidth": 375,
      "minHeight": 790,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false }
}
