+void EmulatorWindow::MountDashboardDisc() {
+  auto picker = xe::ui::FilePicker::Create();
+  picker->set_mode(ui::FilePicker::Mode::kOpen);
+  picker->set_type(ui::FilePicker::Type::kFile);
+  picker->set_multi_selection(false);
+  picker->set_title("Mount Xbox 360 game disc");
+  picker->set_extensions({{"Xbox 360 disc image", "*.iso"}});
+  if (!picker->Show(window_.get()) || picker->selected_files().empty()) {
+    return;
+  }
+  const auto result =
+      emulator_->MountDashboardDisc(picker->selected_files().front());
+  if (XFAILED(result)) {
+    xe::ui::ImGuiDialog::ShowMessageBox(
+        imgui_drawer_.get(), "Disc mount failed",
+        result == X_STATUS_ACCESS_DENIED
+            ? "Open the Xbox 360 dashboard before mounting a disc."
+            : "The selected image is not a supported Xbox 360 game disc.");
+  }
+}
+
+void EmulatorWindow::EjectDashboardDisc() {
+  if (XFAILED(emulator_->EjectDashboardDisc())) {
+    xe::ui::ImGuiDialog::ShowMessageBox(
+        imgui_drawer_.get(), "Disc eject unavailable",
+        "Disc mounting and ejection are available while the dashboard is open.");
+  }
+}
