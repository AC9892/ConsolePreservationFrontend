+dword_result_t XamLoaderLaunchTitleEx_entry(lpvoid_t image_path,
+                                          lpvoid_t mount_path,
+                                          lpvoid_t command_line,
+                                          dword_t flags) {
+  // Support only the dashboard's bare-disc request. Use the existing persistent
+  // loader handoff; the emulator cannot safely switch running titles in place.
+  if (kernel_state()->title_id() != kDashboardID || image_path || mount_path ||
+      command_line || (uint32_t(flags) & ~2u)) {
+    return X_E_NOT_IMPLEMENTED;
+  }
+  auto emulator = kernel_state()->emulator();
+  if (!emulator->dashboard_disc_title_id()) {
+    return X_E_NOTFOUND;
+  }
+  auto entry = kernel_state()->file_system()->ResolvePath("DVD:\\default.xex");
+  if (!entry || entry->device()->name() != "GDFX" ||
+      !entry->device()->mount_path().starts_with("\\Device\\DashboardDisc")) {
+    return X_E_NOTFOUND;
+  }
+  const auto* disc = static_cast<vfs::DiscImageDevice*>(entry->device());
+  auto xam = kernel_state()->GetKernelModule<XamModule>("xam.xex");
+  const auto previous = xam->loader_data();
+  auto& next = xam->loader_data();
+  next.host_path = xe::path_to_utf8(disc->host_path());
+  next.launch_path = "default.xex";
+  next.launch_flags = flags;
+  if (!xam->SaveLoaderData()) {
+    next = previous;
+    XELOGE("Dashboard disc launch handoff could not be saved");
+    return X_E_FAIL;
+  }
+  XELOGI("Dashboard disc launch prepared; backend restart required");
+  auto window = emulator->display_window();
+  auto drawer = emulator->imgui_drawer();
+  if (window && drawer) {
+    window->app_context().CallInUIThreadSynchronous([drawer]() {
+      xe::ui::ImGuiDialog::ShowMessageBox(
+          drawer, "Disc launch prepared",
+          "Close and reopen Xenia to launch the mounted game disc.\n"
+          "This experimental build requires a backend restart when changing "
+          "titles.");
+    });
+  }
+  // The requested title has not run yet. Do not report synchronous completion.
+  return X_E_PENDING;
+}
+DECLARE_XAM_EXPORT1(XamLoaderLaunchTitleEx, kNone, kSketchy);
