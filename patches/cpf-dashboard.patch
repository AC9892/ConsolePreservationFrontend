+dword_result_t XamLaunchURI_entry(dword_t user_index, lpvoid_t uri_ptr,
+                                dword_t flags, dword_t overlapped_ptr) {
+  // Only handle in-place dashboard navigation. Cross-title launches and the
+  // online URI resolver require separate implementations.
+  if (!cvars::dashboard_local_uri ||
+      kernel_state()->title_id() != kDashboardID || !(flags & 4)) {
+    return X_E_NOT_IMPLEMENTED;
+  }
+  if (!uri_ptr) {
+    return X_E_INVALIDARG;
+  }
+  const auto* uri = reinterpret_cast<const char*>(uri_ptr.host_address());
+  const size_t length = strnlen(uri, 0x3FC);
+  if (!length || length >= 0x3FB) {
+    return X_E_INVALIDARG;
+  }
+  const std::string_view request(uri, length);
+  const auto separator = request.find(':');
+  const auto scheme = request.substr(0, separator);
+  const auto arguments = separator == std::string_view::npos
+                             ? std::string_view()
+                             : request.substr(separator + 1);
+  uint32_t package_type = 0;
+  if (scheme == "gameslibrary") {
+    package_type = 1;
+  } else if (scheme == "applibrary") {
+    package_type = 2;
+  } else if (scheme == "contentlibrary") {
+    // The dashboard's Recents tile uses this alias directly, with its own
+    // SortOrder and _Quickplay arguments, rather than a package-type filter.
+  } else {
+    XELOGW("Dashboard URI scheme is outside the experimental library routes");
+    return X_E_NOT_IMPLEMENTED;
+  }
+
+  // Offline library aliases resolve to the dashboard's own embedded pages.
+  // Preserve caller parameters; the guest owns rendering and enumeration.
+  const std::string route =
+      "pam:BuiltIn.Hub.xzp:root:BuiltIn.ContentApp.xzp:contentlibrary:" +
+      (package_type ? fmt::format("PackageType={};{}", package_type, arguments)
+                    : std::string(arguments));
+  if (route.size() >= 0x3F0) {
+    return X_E_INSUFFICIENT_BUFFER;
+  }
+  auto xam = kernel_state()->GetKernelModule<XamModule>("xam.xex");
+  auto& launch_data = xam->loader_data().launch_data;
+  launch_data.assign(0x3FC, 0);
+  xe::store_and_swap<uint32_t>(launch_data.data() + 4, 12);
+  xe::store_and_swap<uint32_t>(launch_data.data() + 8, user_index);
+  std::memcpy(launch_data.data() + 12, route.data(), route.size());
+  // Dashboard URI notification: low word is the launch reason; high word is
+  // the user index. The dashboard reads the payload via GetLaunchData.
+  kernel_state()->BroadcastNotification(0x80040021,
+                                       (uint32_t(user_index) << 16) | 12);
+  XELOGI("Dashboard local library route queued (package type {})", package_type);
+  if (overlapped_ptr) {
+    kernel_state()->CompleteOverlappedImmediate(overlapped_ptr, X_ERROR_SUCCESS);
+    return X_E_PENDING;
+  }
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamLaunchURI, kNone, kSketchy);
