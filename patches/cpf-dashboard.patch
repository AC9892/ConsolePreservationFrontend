@@ -0,0 +1,86 @@
+/**
+ * Xenia : Xbox 360 Emulator Research Project
+ * Released under the BSD license - see LICENSE in the root for more details.
+ */
+#include "xenia/base/cvar.h"
+#include "xenia/base/logging.h"
+#include "xenia/base/memory.h"
+#include "xenia/cpu/xex_crypto.h"
+#include "xenia/kernel/kernel_state.h"
+#include "xenia/kernel/title_id_utils.h"
+#include "xenia/kernel/util/shim_utils.h"
+#include "xenia/kernel/util/xex2_info.h"
+#include "xenia/kernel/xboxkrnl/xecrypt_aes.h"
+#include "xenia/kernel/xboxkrnl/xboxkrnl_private.h"
+
+DEFINE_bool(dashboard_disc_crypto, false,
+            "Experimental retail XEX2 resource decryption for the dashboard.",
+            "Kernel");
+
+namespace xe::kernel::xboxkrnl {
+static bool DashboardDiscCryptoEnabled() {
+  return cvars::dashboard_disc_crypto &&
+         kernel_state()->title_id() == kDashboardID;
+}
+
+dword_result_t XexTransformImageKey_entry(lpvoid_t security, dword_t length) {
+  if (!DashboardDiscCryptoEnabled()) {
+    return X_STATUS_NOT_IMPLEMENTED;
+  }
+  if (!security || length != 0x174) {
+    return X_STATUS_INVALID_PARAMETER;
+  }
+  // Observed XEX2 input is security-info + 8, excluding its two size words.
+  // Mirror the emulator loader's retail key unwrap, not console authorization.
+  auto* data = security.as<uint8_t*>();
+  const auto flags = xe::load_and_swap<uint32_t>(data + 0x104);
+  if (flags & (XEX_IMAGE_CARDEA_KEY | XEX_IMAGE_XEIKA_KEY)) {
+    return X_STATUS_NOT_IMPLEMENTED;
+  }
+  cpu::UnwrapRetailXex2ImageKey(data + 0x148, data + 0x148);
+  XELOGI("Dashboard retail XEX2 image-key transform completed");
+  return X_STATUS_SUCCESS;
+}
+DECLARE_XBOXKRNL_EXPORT1(XexTransformImageKey, kNone, kSketchy);
+
+dword_result_t XeCryptAesCreateKeySchedule_entry(
+    lpvoid_t key, dword_t length, pointer_t<Aes128Schedule> schedule) {
+  if (!DashboardDiscCryptoEnabled()) {
+    return X_STATUS_NOT_IMPLEMENTED;
+  }
+  return CreateAes128Schedule(key.as<const uint8_t*>(), length,
+                              static_cast<Aes128Schedule*>(schedule))
+             ? X_STATUS_SUCCESS
+             : X_STATUS_INVALID_PARAMETER;
+}
+DECLARE_XBOXKRNL_EXPORT1(XeCryptAesCreateKeySchedule, kNone, kSketchy);
+
+static uint32_t DashboardAesCbc(pointer_t<Aes128Schedule> schedule,
+                                lpvoid_t input, dword_t length, lpvoid_t output,
+                                lpvoid_t iv, bool encrypt) {
+  if (!DashboardDiscCryptoEnabled()) {
+    return X_STATUS_NOT_IMPLEMENTED;
+  }
+  return Aes128Cbc(static_cast<Aes128Schedule*>(schedule),
+                   input.as<const uint8_t*>(), length,
+                   output.as<uint8_t*>(), iv.as<uint8_t*>(), encrypt)
+             ? X_STATUS_SUCCESS
+             : X_STATUS_INVALID_PARAMETER;
+}
+
+dword_result_t XeCryptAesCbcEncrypt_entry(pointer_t<Aes128Schedule> schedule,
+                                         lpvoid_t input, dword_t length,
+                                         lpvoid_t output, lpvoid_t iv) {
+  return DashboardAesCbc(schedule, input, length, output, iv, true);
+}
+DECLARE_XBOXKRNL_EXPORT1(XeCryptAesCbcEncrypt, kNone, kSketchy);
+
+dword_result_t XeCryptAesCbcDecrypt_entry(pointer_t<Aes128Schedule> schedule,
+                                         lpvoid_t input, dword_t length,
+                                         lpvoid_t output, lpvoid_t iv) {
+  return DashboardAesCbc(schedule, input, length, output, iv, false);
+}
+DECLARE_XBOXKRNL_EXPORT1(XeCryptAesCbcDecrypt, kNone, kSketchy);
+}  // namespace xe::kernel::xboxkrnl
+
+DECLARE_XBOXKRNL_EMPTY_REGISTER_EXPORTS(DashboardCrypto);
diff --git a/src/xenia/kernel/xboxkrnl/xecrypt_aes.h b/src/xenia/kernel/xboxkrnl/xecrypt_aes.h
new file mode 100644
--- /dev/null
+++ b/src/xenia/kernel/xboxkrnl/xecrypt_aes.h
@@ -0,0 +1,79 @@
+/**
+ * Xenia : Xbox 360 Emulator Research Project
+ * Released under the BSD license - see LICENSE in the root for more details.
+ */
+#ifndef XENIA_KERNEL_XBOXKRNL_XECRYPT_AES_H_
+#define XENIA_KERNEL_XBOXKRNL_XECRYPT_AES_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+#include "third_party/aes_128/aes.h"
+}
+
+namespace xe::kernel::xboxkrnl {
+
+// Private HLE representation for the paired modern AES exports. The observed
+// dashboard treats the schedule as opaque and reserves 0x1D8 bytes for it.
+// This is not a claim about the console's expanded-key memory layout.
+struct Aes128Schedule {
+  std::array<uint8_t, 4> magic;
+  std::array<uint8_t, AES_ROUND_KEY_SIZE> encryption;
+};
+static_assert(sizeof(Aes128Schedule) <= 0x1D8);
+inline constexpr std::array<uint8_t, 4> kAes128ScheduleMagic{'X', 'A', 'E', '1'};
+
+inline bool CreateAes128Schedule(const uint8_t* key, size_t length,
+                                 Aes128Schedule* output) {
+  if (!key || !output || length != AES_BLOCK_SIZE) {
+    return false;
+  }
+  Aes128Schedule result{};
+  aes_key_schedule_128(key, result.encryption.data());
+  result.magic = kAes128ScheduleMagic;
+  *output = result;
+  return true;
+}
+
+inline bool Aes128Cbc(const Aes128Schedule* schedule, const uint8_t* input,
+                      size_t length, uint8_t* output, uint8_t* iv,
+                      bool encrypt) {
+  if (!schedule || schedule->magic != kAes128ScheduleMagic || !iv ||
+      length % AES_BLOCK_SIZE || (length && (!input || !output))) {
+    return false;
+  }
+  // Exact in-place operation is supported; shifted overlaps are not.
+  if (input != output && length) {
+    const auto in = reinterpret_cast<uintptr_t>(input);
+    const auto out = reinterpret_cast<uintptr_t>(output);
+    if ((in < out ? out - in : in - out) < length) {
+      return false;
+    }
+  }
+  for (size_t offset = 0; offset < length; offset += AES_BLOCK_SIZE) {
+    std::array<uint8_t, AES_BLOCK_SIZE> block;
+    std::memcpy(block.data(), input + offset, block.size());
+    if (encrypt) {
+      for (size_t j = 0; j < block.size(); ++j) {
+        block[j] ^= iv[j];
+      }
+      aes_encrypt_128(schedule->encryption.data(), block.data(), output + offset);
+      std::memcpy(iv, output + offset, block.size());
+    } else {
+      const std::array<uint8_t, AES_BLOCK_SIZE> original = block;
+      aes_decrypt_128(schedule->encryption.data(), block.data(), output + offset);
+      for (size_t j = 0; j < block.size(); ++j) {
+        output[offset + j] ^= iv[j];
+      }
+      // Decryption requires carrying the original ciphertext block forward as the
+      // next IV. The decrypted block is only used as the plaintext output.
+      std::memcpy(iv, original.data(), original.size());
+    }
+  }
+  return true;
+}
+}  // namespace xe::kernel::xboxkrnl
+#endif  // XENIA_KERNEL_XBOXKRNL_XECRYPT_AES_H_
