+X_STATUS Emulator::MountDashboardDisc(const std::filesystem::path& path) {
+  if (!is_title_open() || kernel_state_->title_id() != kernel::kDashboardID) {
+    return X_STATUS_ACCESS_DENIED;
+  }
+  const auto mount_path =
+      fmt::format("\\Device\\DashboardDisc{}", ++dashboard_disc_mount_count_);
+  auto device = std::make_unique<vfs::DiscImageDevice>(mount_path, path);
+  if (!device->Initialize()) {
+    return X_STATUS_INVALID_IMAGE_FORMAT;
+  }
+  auto entry = device->ResolvePath("default.xex");
+  auto header = entry ? entry->OpenMapped(MappedMemory::Mode::kRead, 0, 1_MiB)
+                      : nullptr;
+  if (!header || header->size() < 24 ||
+      std::memcmp(header->data(), "XEX2", 4)) {
+    return X_STATUS_INVALID_IMAGE_FORMAT;
+  }
+  const auto* bytes = header->data();
+  const uint32_t security_offset = xe::load_and_swap<uint32_t>(bytes + 16);
+  if (security_offset > header->size() ||
+      header->size() - security_offset < 0x150) {
+    return X_STATUS_INVALID_IMAGE_FORMAT;
+  }
+  const uint32_t count = xe::load_and_swap<uint32_t>(bytes + 20);
+  if (count > (header->size() - 24) / 8) {
+    return X_STATUS_INVALID_IMAGE_FORMAT;
+  }
+  uint32_t title_id = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (xe::load_and_swap<uint32_t>(bytes + 24 + i * 8) !=
+        XEX_HEADER_EXECUTION_INFO) {
+      continue;
+    }
+    const uint32_t offset = xe::load_and_swap<uint32_t>(bytes + 28 + i * 8);
+    if (offset > header->size() || header->size() - offset < 24) {
+      return X_STATUS_INVALID_IMAGE_FORMAT;
+    }
+    title_id = xe::load_and_swap<uint32_t>(bytes + offset + 12);
+    break;
+  }
+  if (!title_id || kernel::IsSystemTitle(title_id)) {
+    return X_STATUS_INVALID_IMAGE_FORMAT;
+  }
+  if (!dashboard_disc_title_id_.load()) {
+    dashboard_disc_previous_partition_.clear();
+    file_system_->FindSymbolicLink(kDefaultPartitionSymbolicLink,
+                                  dashboard_disc_previous_partition_);
+  }
+  file_system_->RegisterDevice(std::move(device));
+  // Keep old devices alive until shutdown: guest file handles may still point
+  // to them after a media change. Only switch the drive aliases on insert/eject.
+  for (auto alias : {"\\Device\\Cdrom0", "DVD:", "D:"}) {
+    file_system_->UnregisterSymbolicLink(alias);
+    file_system_->RegisterSymbolicLink(alias, mount_path);
+  }
+  {
+    std::lock_guard lock(dashboard_disc_metadata_mutex_);
+    std::memcpy(dashboard_disc_media_id_.data(),
+                bytes + security_offset + 0x140,
+                dashboard_disc_media_id_.size());
+    dashboard_disc_title_id_.store(title_id);
+  }
+  kernel_state_->smc()->SetTrayState(X_DVD_TRAY_STATE::CLOSED, false);
+  // The loader's media-change notification carries the detected disc type,
+  // rather than the physical SMC tray-state enumeration.
+  kernel_state_->BroadcastNotification(kXNotificationSystemTrayStateChanged,
+                                       X_DVD_DISC_STATE::XBOX_360_GAME_DISC);
+  XELOGI("Dashboard virtual disc inserted, title {:08X} (read-only)", title_id);
+  return X_STATUS_SUCCESS;
+}
+
+bool Emulator::GetDashboardDiscMediaId(uint8_t* media_id) {
+  std::lock_guard lock(dashboard_disc_metadata_mutex_);
+  if (!dashboard_disc_title_id_.load()) {
+    return false;
+  }
+  std::memcpy(media_id, dashboard_disc_media_id_.data(),
+              dashboard_disc_media_id_.size());
+  return true;
+}
+
+X_STATUS Emulator::EjectDashboardDisc() {
+  if (!is_title_open() || kernel_state_->title_id() != kernel::kDashboardID) {
+    return X_STATUS_ACCESS_DENIED;
+  }
+  {
+    std::lock_guard lock(dashboard_disc_metadata_mutex_);
+    if (!dashboard_disc_title_id_.exchange(0)) {
+      return X_STATUS_SUCCESS;
+    }
+    dashboard_disc_media_id_.fill(0);
+  }
+  for (auto alias : {"\\Device\\Cdrom0", "DVD:", "D:"}) {
+    file_system_->UnregisterSymbolicLink(alias);
+  }
+  if (!dashboard_disc_previous_partition_.empty()) {
+    file_system_->RegisterSymbolicLink(kDefaultPartitionSymbolicLink,
+                                      dashboard_disc_previous_partition_);
+  }
+  kernel_state_->smc()->SetTrayState(X_DVD_TRAY_STATE::OPEN, false);
+  kernel_state_->BroadcastNotification(kXNotificationSystemTrayStateChanged,
+                                       X_DVD_DISC_STATE::NO_DISC);
+  XELOGI("Dashboard virtual disc ejected");
+  return X_STATUS_SUCCESS;
+}
