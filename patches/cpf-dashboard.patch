     }
 
     if (key_binding.lowercase && !uppercase) {
       key_binding.is_pressed = is_down;
+      key.output_key = key_binding.output_key;
       break;
     }
 
     if (!key_binding.uppercase && !key_binding.lowercase) {
       key_binding.is_pressed = is_down;
+      key.output_key = key_binding.output_key;
       break;
     }
   }
+  key_events_.push_back(key);
