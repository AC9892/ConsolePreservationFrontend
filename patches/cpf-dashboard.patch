+dword_result_t XamLaunchURI_entry(dword_t user_index, lpvoid_t uri_ptr,
+                                dword_t flags, dword_t overlapped_ptr) {
+  // Only handle in-place dashboard navigation. Cross-title launches and the
+  // online URI resolver require separate implementations.
+  if (!cvars::dashboard_local_uri ||
+      kernel_state()->title_id() != kDashboardID || !(flags & 4)) {
+    return X_E_NOT_IMPLEMENTED;
+  }
+  if (!uri_ptr) {
+    return X_E_INVALIDARG;
+  }
+  const auto* uri = reinterpret_cast<const char*>(uri_ptr.host_address());
+  const size_t length = strnlen(uri, 0x3FC);
+  if (!length || length >= 0x3FB) {
+    return X_E_INVALIDARG;
+  }
+  const std::string_view request(uri, length);
+  const auto separator = request.find(':');
+  const auto scheme = request.substr(0, separator);
+  const auto arguments = separator == std::string_view::npos
+                             ? std::string_view()
+                             : request.substr(separator + 1);
+  uint32_t package_type = 0;
+  bool game_details = false;
+  if (scheme == "gameslibrary") {
+    package_type = 1;
+  } else if (scheme == "applibrary") {
+    package_type = 2;
+  } else if (scheme == "contentlibrary") {
+    // The dashboard's Recents tile uses this alias directly, with its own
+    // SortOrder and _Quickplay arguments, rather than a package-type filter.
+  } else if (scheme == "gamedetails") {
+    // The original XAM registration selects the gamedetails scene, not the
+    // contentlibrary scene used by the library aliases below.
+    if (arguments.empty()) {
+      return X_E_INVALIDARG;
+    }
+    game_details = true;
+  } else {
+    XELOGW("Dashboard URI scheme is outside the experimental library routes");
+    return X_E_NOT_IMPLEMENTED;
+  }
+
+  // Offline library aliases resolve to the dashboard's own embedded pages.
+  // Preserve caller parameters; the guest owns rendering and enumeration.
+  const std::string route_arguments = game_details
+      ? fmt::format("MediaId={}", arguments)
+      : package_type ? fmt::format("PackageType={};{}", package_type, arguments)
+                     : std::string(arguments);
+  const std::string route = fmt::format(
+      "pam:BuiltIn.Hub.xzp:root:BuiltIn.ContentApp.xzp:{}:{}",
+      game_details ? "gamedetails" : "contentlibrary", route_arguments);
+  if (route.size() >= 0x3F0) {
+    return X_E_INSUFFICIENT_BUFFER;
+  }
+  auto xam = kernel_state()->GetKernelModule<XamModule>("xam.xex");
+  auto& launch_data = xam->loader_data().launch_data;
+  launch_data.assign(0x3FC, 0);
+  xe::store_and_swap<uint32_t>(launch_data.data() + 4, 12);
+  xe::store_and_swap<uint32_t>(launch_data.data() + 8, user_index);
+  std::memcpy(launch_data.data() + 12, route.data(), route.size());
+  // Dashboard URI notification: low word is the launch reason; high word is
+  // the user index. The dashboard reads the payload via GetLaunchData.
+  kernel_state()->BroadcastNotification(0x80040021,
+                                       (uint32_t(user_index) << 16) | 12);
+  if (game_details) {
+    XELOGI("Dashboard Game Details route queued");
+  } else {
+    XELOGI("Dashboard local library route queued (package type {})", package_type);
+  }
+  if (overlapped_ptr) {
+    kernel_state()->CompleteOverlappedImmediate(overlapped_ptr, X_ERROR_SUCCESS);
+    return X_E_PENDING;
+  }
+  return X_E_SUCCESS;
+}
+DECLARE_XAM_EXPORT1(XamLaunchURI, kNone, kSketchy);
+
+dword_result_t XamLoaderLaunchTitleEx_entry(lpvoid_t image_path,
+                                          lpvoid_t mount_path,
+                                          lpvoid_t command_line,
+                                          dword_t flags) {
+  // Support only the dashboard's bare-disc request. Use the existing persistent
+  // loader handoff; the emulator cannot safely switch running titles in place.
+  if (kernel_state()->title_id() != kDashboardID || image_path || mount_path ||
+      command_line || (uint32_t(flags) & ~2u)) {
+    return X_E_NOT_IMPLEMENTED;
+  }
+  auto emulator = kernel_state()->emulator();
+  if (!emulator->dashboard_disc_title_id()) {
+    return X_E_NOTFOUND;
+  }
+  auto entry = kernel_state()->file_system()->ResolvePath("DVD:\\default.xex");
+  if (!entry || entry->device()->name() != "GDFX" ||
+      !entry->device()->mount_path().starts_with("\\Device\\DashboardDisc")) {
+    return X_E_NOTFOUND;
+  }
+  const auto* disc = static_cast<vfs::DiscImageDevice*>(entry->device());
+  auto xam = kernel_state()->GetKernelModule<XamModule>("xam.xex");
+  const auto previous = xam->loader_data();
+  auto& next = xam->loader_data();
+  next.host_path = xe::path_to_utf8(disc->host_path());
+  next.launch_path = "default.xex";
+  next.launch_flags = flags;
+  if (!xam->SaveLoaderData()) {
+    next = previous;
+    XELOGE("Dashboard disc launch handoff could not be saved");
+    return X_E_FAIL;
+  }
+  XELOGI("Dashboard disc launch prepared; backend restart required");
+  auto window = emulator->display_window();
+  auto drawer = emulator->imgui_drawer();
+  if (window && drawer) {
+    window->app_context().CallInUIThreadSynchronous([drawer]() {
+      xe::ui::ImGuiDialog::ShowMessageBox(
+          drawer, "Disc launch prepared",
+          "Close and reopen Xenia to launch the mounted game disc.\n"
+          "This experimental build requires a backend restart when changing "
+          "titles.");
+    });
+  }
+  // The requested title has not run yet. Do not report synchronous completion.
+  return X_E_PENDING;
+}
