diff --git a/src/xenia/kernel/xam/tile_texture.h b/src/xenia/kernel/xam/tile_texture.h
new file mode 100644
--- /dev/null
+++ b/src/xenia/kernel/xam/tile_texture.h
@@ -0,0 +1,35 @@
+#ifndef XENIA_KERNEL_XAM_TILE_TEXTURE_H_
+#define XENIA_KERNEL_XAM_TILE_TEXTURE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace xe::kernel::xam {
+
+// Copy decoded RGBA into guest ARGB rows, preserving pitch padding.
+inline bool CopyTileRgbaToArgb(std::span<const uint8_t> rgba, size_t width,
+                               size_t height, std::span<uint8_t> destination,
+                               size_t stride, size_t destination_height) {
+  if (!width || !height || width > stride / 4 ||
+      height > destination_height || stride == 0 ||
+      destination_height > destination.size() / stride ||
+      height > rgba.size() / 4 / width) {
+    return false;
+  }
+  for (size_t y = 0; y < height; ++y) {
+    for (size_t x = 0; x < width; ++x) {
+      const auto* source = rgba.data() + (y * width + x) * 4;
+      auto* target = destination.data() + y * stride + x * 4;
+      target[0] = source[3];
+      target[1] = source[0];
+      target[2] = source[1];
+      target[3] = source[2];
+    }
+  }
+  return true;
+}
+
+}  // namespace xe::kernel::xam
+
+#endif  // XENIA_KERNEL_XAM_TILE_TEXTURE_H_
diff --git a/src/xenia/kernel/testing/tile_texture_test.cc b/src/xenia/kernel/testing/tile_texture_test.cc
new file mode 100644
--- /dev/null
+++ b/src/xenia/kernel/testing/tile_texture_test.cc
@@ -0,0 +1,29 @@
+#include <array>
+#include "third_party/catch/single_include/catch2/catch.hpp"
+#include "xenia/kernel/xam/tile_texture.h"
+
+using xe::kernel::xam::CopyTileRgbaToArgb;
+
+TEST_CASE("Gamer tile conversion honors row pitch and channel order", "[tile]") {
+  const std::array<uint8_t, 8> source{1, 2, 3, 4, 5, 6, 7, 8};
+  std::array<uint8_t, 16> destination;
+  destination.fill(0xCD);
+  REQUIRE(CopyTileRgbaToArgb(source, 1, 2, destination, 8, 2));
+  const std::array<uint8_t, 16> expected{
+      4, 1, 2, 3, 0xCD, 0xCD, 0xCD, 0xCD,
+      8, 5, 6, 7, 0xCD, 0xCD, 0xCD, 0xCD};
+  REQUIRE(destination == expected);
+}
+
+TEST_CASE("Gamer tile rejects invalid extents without touching output", "[tile]") {
+  const std::array<uint8_t, 8> source{};
+  std::array<uint8_t, 16> destination;
+  destination.fill(0xCD);
+  const auto before = destination;
+  REQUIRE_FALSE(CopyTileRgbaToArgb(source, 2, 1, destination, 4, 1));
+  REQUIRE_FALSE(CopyTileRgbaToArgb(source, 1, 2, destination, 4, 1));
+  REQUIRE_FALSE(CopyTileRgbaToArgb(source, 1, 2, destination, 12, 2));
+  REQUIRE_FALSE(CopyTileRgbaToArgb(source, 1, 3, destination, 4, 3));
+  REQUIRE_FALSE(CopyTileRgbaToArgb(source, 0, 1, destination, 4, 1));
+  REQUIRE(destination == before);
+}
